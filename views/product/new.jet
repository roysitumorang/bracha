{{ include "../partials/header" }}

<h1><a href="/product">Product</a> > New</h1>
{{ if message }}<p>{{ message }}</p>{{ end }}
<form method="POST" action="/product">
    <div class="col-12">
        <label for="code" class="form-label">Code</label>
        <input type="text" name="code" value="{{ product.Code }}" class="form-control" id="name" placeholder="code" autocomplete="off" />
    </div>
    {{ include "_form" }}
</form>

{{ include "../partials/footer" }}
