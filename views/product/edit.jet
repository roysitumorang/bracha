{{ include "../partials/header" }}

<h1><a href="/product">Product</a> > Edit #{{ product.ID }}</h1>
{{ if message }}<p>{{ message }}</p>{{ end }}
<form method="POST" action="/product/{{ product.ID }}">
    <input type="hidden" name="code" value="{{ product.Code }}" class="form-control" id="name" placeholder="code" autocomplete="off" />
    {{ include "_form" }}
</form>

{{ include "../partials/footer" }}
