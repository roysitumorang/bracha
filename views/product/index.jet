{{ include "../partials/header" }}

<h1>Product</h1>
{{ if message }}<p>{{ message }}</p>{{ end }}
<form method="GET" action="/product" class="d-flex" role="search">
    <div class="col-12">
        <div class="col-md-4">
            <label for="q" class="form-label">Category</label>
            <input type="text" name="q" value="{{ q }}" id="q" class="form-control me-2" placeholder="Search" aria-label="Search">
        </div>
        <div class="col-md-4">
            <label for="limit" class="form-label">Per Page</label>
            <select name="limit" class="form-select" id="limit">
                <option value="10"{{ if limit == "" || limit == 10 }} selected{{ end}}>10</option>
                <option value="25"{{ if limit == 25 }} selected{{ end}}>25</option>
                <option value="50"{{ if limit == 50 }} selected{{ end}}>50</option>
                <option value="100"{{ if limit == 100 }} selected{{ end}}>100</option>
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-primary btn-md" type="submit"><i class="fa-classic fa-solid fa-search"></i> Search</button>
            <button class="btn btn-secondary btn-md" type="reset"><i class="fa-classic fa-solid fa-reset"></i> Reset</button>
        </div>
    </div>
</form>
<div class="table-responsive small">
    <table class="table table-striped table-sm">
        <thead>
            <tr>
                <th scope="col">No</th>
                <th scope="col">Code</th>
                <th scope="col">Name</th>
                <th scope="col">Category</th>
                <th scope="col">UOM</th>
                <th scope="col">Stock Type</th>
                <th scope="col">Minimum / Current Stock</th>
                <th scope="col">Purchase / Selling Price</th>
                <th scope="col">Weight</th>
                <th scope="col">Discount</th>
                <th scope="col">#</th>
            </tr>
        </thead>
        <tbody>
            {{ range _, item := response.Data.Rows }}
            <tr>
                <td>{{ item.RowNo }}</td>
                <td>{{ item.Code }}</td>
                <td>{{ item.Name }}</td>
                <td>{{ if item.CategoryID }}{{ item.CategoryID }}{{ else }}-{{ end }}</td>
                <td>{{ item.UOM }}</td>
                <td>{{ if item.StockType == 0 }}Limited{{ else }}Unlimited{{ end }}</td>
                <td>{{ item.MinimumStock }} / {{ item.Stock }}</td>
                <td>{{ item.PurchasePrice }} / {{ item.SellingPrice }}</td>
                <td>{{ item.Weight }} gram</td>
                <td>{{ item.DiscountValue }}{{ if item.DiscountType == 0 }} %{{ end }}</td>
                <td><a href="/product/{{ item.ID }}/edit"><i class="fa-classic fa-solid fa-edit"></i> Edit</a></td>
            </tr>
            {{ end }}
        </tbody>
    </table>
</div>
<p><a href="/product/new"><button type="button" class="btn btn-primary btn-md"><i class="fa-classic fa-solid fa-plus"></i> Create</button></a></p>
{{ if response.Data.Pagination.Info.Pages > 0 }}
    <ul class="pagination">
        <li class="page-item"><a class="page-link" href="{{ response.Data.Pagination.Links.First }}">First</a></li>
        {{ if response.Data.Pagination.Links.Previous != "" }}
        <li class="page-item"><a class="page-link" href="{{ response.Data.Pagination.Links.Previous }}">Previous</a></li>
        {{ end }}
        <li class="page-item"><a class="page-link" href="{{ response.Data.Pagination.Links.Current }}">Current</a></li>
        {{ if response.Data.Pagination.Links.Next != "" }}
        <li class="page-item"><a class="page-link" href="{{ response.Data.Pagination.Links.Next }}">Next</a></li>
        {{ end }}
        {{ if response.Data.Pagination.Links.Last != "" }}
        <li class="page-item"><a class="page-link" href="{{ response.Data.Pagination.Links.Last }}">Last</a></li>
        {{ end }}
    </ul>
{{ end }}

{{ include "../partials/footer" }}
